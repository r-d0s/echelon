;-=--=--=--=--=--=--=--=--=--=--=--=--=--=--=--=--=--=--=--
; STACK OPERATORS
;
; Run: ./echelon -f examples/reference/stack_operators.ech
;-=--=--=--=--=--=--=--=--=--=--=--=--=--=--=--=--=--=--=--

func: test_stack_basics

    "-=- BASIC OPS: DUP, SWAP, POP & CLEAR -=-" puts_p
    10 int 20 int
    dup                 ; dup TOS
    swap                ; swap top 2 element
    pop                 ; remove top element
    clear               ; clear whole stack
    return

func: test_adv_dup

    "-=- DUPLICATE & REVERSE: DUP_N & REV -=-" puts_p
    1 int 2 int 3 int
    2 int dup_n             ; dup top 2 item
    dump_rts

    rev                     ; reverse whole stack
    dump_rts
    clear
    return

func: test_range_clearing

    "-=- CLEAR_ABOVE & CLEAR_BELOW -=-" puts_p
    10 int 20 int 30 int 40 int 50 int
    2 int clear_above       ; clear items above index 2
    dump_rts
    clear

    1 int 2 int 3 int 4 int 5 int
    2 int clear_below       ; clear items below index 2 from bottom
    dump_rts
    clear
    return

func: test_shifting

    "-=- SHIFT_UP, SHIFT_DOWN, SHIFT_UP_N & SHIFT_DOWN_N -=-" puts_p
    1 int 2 int 3 int 4 int
    shift_up
    dump_rts
    shift_down
    dump_rts

    2 int shift_up_n        ; shift up by N slots
    dump_rts

    2 int shift_down_n      ; shift down by N slots
    dump_rts
    clear
    return

func: test_lookup_and_size

    "-=- STACK INFO: STACK_SIZE, VALUE_AT & [VALUE_AT] -=-" puts_p
    10 int 20 int 30 int 40 int
    stack_size      ; push on the number of stack elements
    dump_rts
    pop

    2 int value_at      ; cpy element at index 2 to TOS
    dump_rts
    pop

    2 int [value_at]    ; make direct update to the stack using index[2]
    dump_rts
    clear
    return

func: test_indexed_swaps

    "-=- DIRECT SWAPPING: SWAP_TOP_N, SWAP_BOTTOM_N & SWAP_POS -=-" puts_p
    1 int 2 int 3 int 4 int 5 int
    2 int swap_top_n        ; swap top N elements
    dump_rts

    2 int swap_bottom_n     ; swap bottom N elements
    dump_rts

    1 int 3 int swap_pos    ; swap indexes [1] <--> [3]
    dump_rts
    clear
    return

func: test_args_and_pop_n

    "-=- ARGS & BULK DELETES: DUP_ARGS & POP_N -=-" puts_p
    1 int 2 int 3 int
    dup_args
    dump_rts
    clear

    10 int 20 int 30 int 40 int 50 int
    3 int pop_n     ; pop 3 items from top of stack
    dump_rts
    clear
    return


_start:

    test_stack_basics       call_func
    test_adv_dup            call_func
    test_range_clearing     call_func
    test_shifting           call_func
    test_lookup_and_size    call_func
    test_indexed_swaps      call_func
    test_args_and_pop_n     call_func

    dump_rts
