;-------------------------------------------------------------------
; <i>, <f> & String Comparison Operators
;
; RUN: ./echelon -f examples/reference/comparison_and_string_ops.ech
;-------------------------------------------------------------------

_start:

    2 int mem_alloc str1 def_i          ; allocate memory for strings
    2 int mem_alloc str2 def_i
    
    str1 peek 97 int [poke_8]           ; str1 'a' (97) then add NULL
    str1 peek 1 int + 0 int [poke_8]
    str1 peek puts_p

    str2 peek 98 int [poke_8]           ; str2 'b' (98) then add NULL
    str2 peek 1 int + 0 int [poke_8]
    str2 peek puts_p

    "--- CMP_STR_U ---" puts_p

    str1 peek str2 peek cmp_str_u       ; 'a' < 'b' -> -1
    print_i pop                         ; -1
    

    str2 peek str1 peek cmp_str_u       ; 'b' > 'a' -> 1
    print_i pop                         ; 1

    str1 peek puts_p        ; print str1 'a' (97)
    ;----------------------------------------------------------------------------------------
    ; update str2 with a high ascii byte value 144 (0x90) & then add NULL.
    ; '\0' NULL is already set, but will still show you how to update it using another method
    ;----------------------------------------------------------------------------------------
    str2 peek dup 144 int [poke_8]      ; we can dup it now, ready for the next line
    dup ++ 0 int [poke_8]               ; dup again for next line (puts_p), str++ then add '\0'
    [peek_8] print_ptr pop              ; the last dup left a copy for us to print & then pop
                                        ; puts can't display this char (144) use print_ptr instead


    str1 peek str2 peek cmp_str_u   ; unsigned cmp: 1 < 144 -> -1
    print_i                         ; -1


    str2 peek str1 peek cmp_str_u   ; unsigned cmp: 144 > 1 -> 1
    print_i                         ; 1

                                    ; update str2 to match str1 exactly:
    str2 peek 97 int [poke_8]       ; NULL already set earlier

    str1 peek str2 peek cmp_str_u       ; identical match check -> 0
    print_i pop                         ; 0

    str1 peek pop_free
    str2 peek pop_free
    clear

    "--- <i> ---" puts_p
    
    5 int 10 int <i> print_i        ; -1
    10 int 5 int <i> print_i        ; 1
    5 int 5 int <i> print_i         ; 0
    -5 int 10 int <i> print_i       ; -1
    clear

    "--- <f> ---" puts_p
    
    3.5 float 4.2 float <f> print_i     ; -1
    4.2 float 3.5 float <f> print_i     ;  1
    3.5 float 3.5 float <f> print_i     ; 0
    -3.5 float 4.2 float <f> print_i    ; -1
    clear
