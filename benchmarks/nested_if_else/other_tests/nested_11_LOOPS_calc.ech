;--------------------------------------------------------------------------;
; this test uses 11 nested LOOPs & a variable to count ALL the iterations. ;
; Valgrind takes too long running this test, so reduce some of the outer   ;
; iteration limits if you're planning on using it.                         ;
;                                                                          ;
; run: ./echelon -f benchmarks/nested_if_else/nested_11_LOOPS_calc.ech     ;
;--------------------------------------------------------------------------;

func: nested_loops

    0 int iteration def_i
    0 int loop_var_1 def_i
    0 int loop_var_2 def_i
    0 int loop_var_3 def_i
    0 int loop_var_4 def_i
    0 int loop_var_5 def_i
    0 int loop_var_6 def_i
    0 int loop_var_7 def_i
    0 int loop_var_8 def_i
    0 int loop_var_9 def_i
    0 int loop_var_10 def_i
    0 int loop_var_11 def_i

    {
        1 int iteration +=
        {
            1 int iteration +=
            {
                1 int iteration +=
                {
                    1 int iteration +=
                    {
                        1 int iteration +=
                        {
                            1 int iteration +=
                            {
                                1 int iteration +=
                                {
                                    1 int iteration +=
                                    {
                                        1 int iteration +=
                                        {
                                            1 int iteration +=
                                            {
                                                ;iteration peek "iteration current: %d\n" printf pop
                                                1 int iteration +=
                                                1 int loop_var_11 +=
                                            } loop_var_11 peek 10 int < loop
                                            0 int loop_var_11 =

                                            1 int loop_var_10 +=
                                        } loop_var_10 peek 10 int < loop
                                        0 int loop_var_10 =

                                        1 int loop_var_9 +=
                                    } loop_var_9 peek 10 int < loop
                                    0 int loop_var_9 =

                                    1 int loop_var_8 +=
                                } loop_var_8 peek 5 int < loop
                                0 int loop_var_8 =

                                1 int loop_var_7 +=
                            } loop_var_7 peek 5 int < loop
                            0 int loop_var_7 =

                            1 int loop_var_6 +=
                        } loop_var_6 peek 5 int < loop
                        0 int loop_var_6 =

                        1 int loop_var_5 +=
                    } loop_var_5 peek 5 int < loop
                    0 int loop_var_5 =

                    1 int loop_var_4 +=
                } loop_var_4 peek 5 int < loop
                0 int loop_var_4 =

                1 int loop_var_3 +=
            } loop_var_3 peek 5 int < loop
            0 int loop_var_3 =

            1 int loop_var_2 +=
        } loop_var_2 peek 10 int < loop
        0 int loop_var_2 =

        1 int loop_var_1 +=
    } loop_var_1 peek 10 int < loop

    iteration peek "iteration current: %d\n" printf
    ; 10 + 100 + 500 + 2,500 + 12,500 + 62,500 + 312,500 + 1,562,500
    ; + 15,625,000 + 156,250,000 + 1,562,500,000 = 1,736,328,110

    return


_start:
    nested_loops    call_func

