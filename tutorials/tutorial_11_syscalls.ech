;----------------------------------------------------------------------------------------------------
; tutorial_11: System Calls
;
; sys_call lets you run Linux syscalls directly.
;
;   stack: [arg_n, arg2, arg1, syscall_num, total_args] --> [result]
;
;   total_args = 1 + number of params (syscall_num counts as 1)
;   result (rax) is pushed onto the stack, store it, use it or pop it.
;
; valgrind -s --track-origins=yes --leak-check=full ./echelon -f tutorials/tutorial_11_syscalls.ech
;---------------------------------------------------------------------------------------------------

_start:

    ;--- GETPID (syscall 39, 0 params)
    39 int 1 int sys_call
    "PID: %d\n" printf pop

    ;--- GETPPID (syscall 110, 0 params)
    110 int 1 int sys_call
    "Parent PID: %d\n" printf pop

    ;--- WRITE to stdout (syscall 1, 3 params: fd, buf, count)
    ; stack order: count, buf, fd, syscall_num, total_args
    ; total_args = 1 (syscall) + 3 (params) = 4

    "Hello from syscall: 1!\n" msg def_str

    msg peek len_str        ; count
    msg peek                ; buf
    1 int                   ; fd (using stdout here..)
    1 int                   ; syscall_num
    4 int                   ; total_args
    sys_call

    "wrote %d bytes\n" printf pop   ; ret value (rax) printed, now pop it off

    ;----- OPEN file (syscall 2, 3 params: filename, flags, mode)
    ; 577 = O_WRONLY | O_CREAT | O_TRUNC (on x86_64 Linux)
    ; 420 = 0644 in octal

    "/tmp/syscall_test.txt" filename def_str

    420 int             ; mode 0644
    577 int             ; flags
    filename peek       ; filename (from above)
    2 int               ; syscall_num
    4 int               ; total_args
    sys_call

    "fd: %d\n" printf       ; return value (rax) is still on the stack
    fd def_i                ; so save it in a new var 'fd'

    ;--- WRITING TO FILE
    "writing this using syscall: 1!\n" data def_str

    data peek len_str       ; count
    data peek               ; buf
    fd peek                 ; fd
    1 int                   ; syscall_num
    4 int                   ; total_args
    sys_call

    "wrote %d bytes\n" printf pop   ; return value (rax) deleted

    ;----- CLOSE (syscall 3, 1 param: fd)
    fd peek         ; fd
    3 int           ; syscall_num
    2 int           ; total_args
    sys_call

    "close syscall returned: %d\n" printf pop

    ;----- OPEN file (syscall 2, 3 params: filename, flags, mode)
    0 int               ; O_RDONLY
    0 int               ; mode (ignored)
    filename peek       ; declared earlier
    2 int               ; syscall_num
    4 int               ; total_args
    sys_call

    read_fd def_i       ; save return val (fd)

    100 int mem_alloc buffer def_i  ; allocate 100 byte buffer

    ;----- READ file (syscall 0, 3 params: fd, buf, count)
    100 int             ; count
    buffer peek         ; buf
    read_fd peek        ; fd
    0 int               ; syscall_num
    4 int               ; total_args
    sys_call            ; read(fd, buf, count)

    dup bytes_read def_i   ; dup needed, otherwise next line fails!

    "read %d bytes\n" printf pop

    buffer peek bytes_read peek +  ; NULL-term buffer so puts doesn't seg-fault!
    0 int [poke_8]                 ; [poke_8] expects [address, value]

    buffer peek puts

    ;----- CLOSE & CLEAN-UP
    read_fd peek        ; fd
    3 int               ; syscall_num
    2 int               ; total_args
    sys_call

    "close returned: %d\n" printf pop

    buffer peek pop_free    ; tidy up..
